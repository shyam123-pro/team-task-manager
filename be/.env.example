# Copy to .env for local dev. On Vercel, set the same keys in:
# Project → Settings → Environment Variables (Production + Preview), then Redeploy.

MONGO_URI=mongodb+srv://USER:PASS@cluster.example.mongodb.net/dbname
JWT_SECRET=at-least-sixteen-chars-long
JWT_EXPIRES_IN=7d
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
